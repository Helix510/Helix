            {/* PARAMETER VALUE LABELS */}
            <div className="grid grid-cols-2 gap-x-4 gap-y-1.5 font-mono text-xs border-l border-[#1d2030] pl-6">
              <div className="flex justify-between"><span className="text-[#454866] text-[10px] uppercase">RATING</span><span className="text-[#2de2a0] font-black">{report.aiAnalysis.recommendation}</span></div>
              <div className="flex justify-between"><span className="text-[#454866] text-[10px] uppercase">SCORE</span><span className="text-[#ffc85c] font-bold">{report.aiAnalysis.confidenceScore}/100</span></div>
              <div className="flex justify-between"><span className="text-[#454866] text-[10px] uppercase">TUNER</span><span className="text-[#00E5FF] font-bold">ACTIVE</span></div>
              <div className="flex justify-between"><span className="text-[#454866] text-[10px] uppercase">PIPELINE</span><span className="text-[#8c92b5] font-bold">LINKED</span></div>
            </div>
          </div>

          <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            {/* RADIAL WHEEL CONTAINER */}
            <div className="space-y-6">
              <div className="bg-[#0c0e14] border border-[#1d2030] rounded-xl p-5 flex flex-col items-center relative overflow-hidden">
                <span className="text-[9px] font-mono text-[#454866] tracking-widest uppercase self-start mb-4">TACTICAL POSITION MATRIX</span>
                
                <div className="relative mt-2">
                  <svg width="190" height="115" viewBox="0 0 180 110" className="overflow-visible">
                    <defs>
                      <linearGradient id="radialGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stopColor="#ff4f70" />
                        <stop offset="50%" stopColor="#ffc85c" />
                        <stop offset="100%" stopColor="#2de2a0" />
                      </linearGradient>
                    </defs>
                    <path d="M 20 90 A 70 70 0 0 1 160 90" fill="none" stroke="#181b26" strokeWidth="10" strokeLinecap="round"/>
                    <path 
                      d="M 20 90 A 70 70 0 0 1 160 90" 
                      fill="none" 
                      stroke="url(#radialGrad)" 
                      strokeWidth="10" 
                      strokeLinecap="round"
                      strokeDasharray="220"
                      strokeDashoffset={220 - (220 * (report.aiAnalysis.confidenceScore || 50)) / 100}
                      className="transition-all duration-1000 ease-out"
                    />
                    <line 
                      x1="90" y1="90" 
                      x2={90 + 58 * Math.cos((180 - (180 * (report.aiAnalysis.confidenceScore || 50)) / 100) * Math.PI / 180)} 
                      y2={90 - 58 * Math.sin((180 - (180 * (report.aiAnalysis.confidenceScore || 50)) / 100) * Math.PI / 180)} 
                      stroke="#ffffff" strokeWidth="2.5" strokeLinecap="round"
                    />
                    <circle cx="90" cy="90" r="4.5" fill="#ffffff"/>
                  </svg>
                  
                  <div className="absolute top-[75px] left-0 right-0 text-center font-mono">
                    <span className="text-xl font-black tracking-tight text-white">{report.aiAnalysis.recommendation}</span>
                    <p className="text-[9px] text-[#8c92b5] uppercase tracking-wider mt-0.5">MATRIX ANCHOR RATING</p>
                  </div>
                </div>

                <div className="w-full text-center mt-4 pt-4 border-t border-[#1d2030] text-[11px] font-mono text-[#8c92b5] leading-relaxed px-1">
                  {report.aiAnalysis.confidenceRationale}
