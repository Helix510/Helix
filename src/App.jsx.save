                  style={{ width: `${report.aiAnalysis.confidenceScore}%` }}
                ></div>
                <div 
                  className="absolute top-1/2 -translate-y-1/2 w-1.5 h-1.5 bg-white rounded-full shadow-[0_0_8px_white]"
                  style={{ left: `${report.aiAnalysis.confidenceScore}%`, transform: 'translate(-50%, -50%)' }}
                ></div>
              </div>
              <div className="flex justify-between font-mono text-[8px] text-[#454866]">
                <span>SUPPORT BASELINE</span>
                <span>RESISTANCE THRESHOLD</span>
