              <path d="M30,65 C45,65 35,35 50,35 C65,35 55,65 70,65" stroke="url(#helixGrad)" strokeWidth="3.5" strokeLinecap="round" strokeDasharray="3 3" className="opacity-60"/>
              <circle cx="50" cy="50" r="3" fill="#ffffff" className="animate-pulse"/>
              <circle cx="30" cy="35" r="2.5" fill="#2de2a0" />
              <cix="70" cy="65" r="2.5" fill="#ffc85c" />
            </svg>
            <div className="absolute inset-0 bg-gradient-to-t from-[#2de2a0]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>

          <div>
            <div className="flex items-center gap-2.5">
