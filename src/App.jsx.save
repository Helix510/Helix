                  <div className="flex items-center gap-1.5 text-[#454866]">
                    <Eye size={12} className="text-[#2de2a0]" />
                    <span className="text-[9px] uppercase tracking-widest font-bold text-gray-400">INSIDER CORPORATE DIRECTIONAL ACTIONS</span>
