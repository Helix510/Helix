                  <h3 className="text-xs font-mono font-bold text-[#ff4f70] tracking-wider flex items-center gap-1.5">
                    <Compass size={13} /> BEAR VOLATILITY VECTORS
                  </h3>
                  <ul className="text-xs font-mono space-y-2 text-[#8c92b5] list-none pl-0">
                    {report.aiAnalysis.bearCase?.map((b, i) => (
                      <li key={i} className="flex items-start gap-2.5 bg-[#08090d] p-2.5 rounded-lg border border-[#1d2030] text-gray-300">
                        <ArrowDownRight size={14} className="text-[#ff4f70] shrink-0 mt-0.5" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              {/* AUDIT ANOMALIES MAP */}
              {report.aiAnalysis.redFlags && report.aiAnalysis.redFlags.length > 0 && (
                <div className="bg-[#ffc85c]/5 border border-[#ffc85c]/10 p-5 rounded-xl space-y-3">
