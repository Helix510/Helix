          <footer className="pt-5 border-t border-[#1d2030] flex flex-col md:flex-row justify-between text-[9px] font-mono text-[#454866] gap-2">
            <div>DISCLAIMER: DATA MATRIX CHANNELS RECONCILED UNDER CORE ADVISORY SPECIFICATION PARAMETERS.</div>
            <div className="shrink-0 text-right uppercase tracking-wider">MATRIX STATUS: NOMINAL // CORE WORKSPACE LOCK SECURE</div>
          </footer>

