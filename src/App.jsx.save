      {/* PIPELINE LIVE STATUS INDICATORS */}
      {loading && (
        <div className="bg-[#0c0e14] border border-[#2de2a0]/20 p-5 rounded-xl space-y-4 relative overflow-hidden">
          <div className="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-[#2de2a0] to-transparent opacity-60"></div>
          <div className="flex items-center justify-between">
            <span className="text-xs font-mono font-bold text-[#2de2a0] flex items-center gap-2 animate-pulse">
              <Activity size={14} className="animate-spin" /> DISPATCHING SYSTEM SYNC ROUTINES...
            </span>
          </div>
          <div className="grid grid-cols-2 md:grid-cols-4 gap-3 text-[10px] font-mono">
            {['SEC_STREAM_MAPPER', 'CONCURRENCY_DESERIALIZER', 'VECTOR_CHART_MAP', 'SCHEMA_AUTOPATCH'].map((agent) => (
              <div key={agent} className="bg-[#111318] border border-[#1d2030] p-3 rounded-lg flex justify-between items-center relative overflow-hidden">
                <span className="text-[#8c92b5]">{agent}</span>
                <span className="text-[#ffc85c] animate-pulse flex items-center gap-1">● PARSING</span>
                <div className="absolute bottom-0 left-0 h-[1.5px] bg-[#2de2a0] w-1/2 animate-[loading_1.2s_infinite_ease-in-out]"></div>
              </div>
            ))}
          </div>
        </div>
      )}

      {error && (
        <div className="bg-[#ff4f70]/5 border border-[#ff4f70]/20 text-[#ff4f70] p-4 rounded-xl font-mono text-xs flex items-center gap-3">
          <ShieldAlert size={16} /> <span className="font-bold">NETWORK FAILURE:</span> {error}
        </div>
      )}

      {/* DYNAMIC METRIC MATRIX REPORT PANELS */}
      {report && report.aiAnalysis && (
        <div className="space-y-6">
          
          {/* TOP SUMMARY STRIPBOARD */}
          <div className="bg-[#0c0e14] border border-[#1d2030] rounded-xl p-5 grid grid-cols-1 md:grid-cols-3 gap-6 items-center relative overflow-hidden">
            <div className="absolute top-0 left-0 bottom-0 w-[3px] bg-[#2de2a0]"></div>
            
            <div className="space-y-0.5">
              <span className="text-[9px] font-mono font-bold text-[#454866] tracking-widest uppercase">TARGET EQUITY METRIC</span>
              <div className="flex items-baseline gap-3">
                <h2 className="text-3xl font-mono font-black tracking-tight text-white">{report.ticker}</h2>
                <span className="text-[#2de2a0] bg-[#2de2a0]/10 font-mono font-bold text-[10px] px-2.5 py-0.5 rounded border border-[#2de2a0]/20 uppercase tracking-wider">
                  STREAM VERIFICATION SECURE
                </span>
              </div>
            </div>

            {/* BAR COMPASS OVERLAY TRACK */}
            <div className="space-y-1.5 w-full">
              <div className="flex justify-between font-mono text-[10px] text-[#8c92b5]">
                <span>STRATEGIC POSITION POSITIONING</span>
                <span className="text-white font-bold">{report.aiAnalysis.confidenceScore}% SPEED MATRIX</span>
              </div>
              <div className="w-full h-2 bg-[#181b26] rounded-full overflow-hidden relative border border-[#1d2030]">
                <div 
