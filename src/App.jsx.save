              <span className="px-2 py-0.5 bg-[#2de2a0]/10 border border-[#2de2a0]/20 text-[9px] font-mono text-[#2de2a0] rounded uppercase tracking-wider font-extrabold">v2.7 Live</span>
            </div>
            <p className="text-[11px] font-mono text-[#454866] mt-0.5 tracking-wider uppercase">High-Performance Autonomous Research Matrix & Equity Visualizer</p>
          </div>
        </div>
        
        <div className="flex items-center gap-2 w-full md:w-auto">
          <div className="relative w-full md:w-52">
            <input 
              type="text" 
              placeholder="ENTER TICKER (E.G. CAVA)..." 
              value={ticker}
              onChange={(e) => setTicker(e.target.value)}
              onKeyDown={(e) => e.key === 'Enter' && triggerResearch()}
              className="bg-[#0c0e14] border border-[#252840] rounded-lg px-3.5 py-2 text-xs text-white font-mono placeholder-[#454866] focus:outline-none focus:border-[#2de2a0] focus:ring-1 focus:ring-[#2de2a0] w-full uppercase tracking-widest transition-all"
            />
          </div>
          <button 
            onClick={() => triggerResearch()}
            disabled={loading}
