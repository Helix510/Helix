                <div className="space-y-2">
                  <span className="text-[9px] font-mono text-[#454866] tracking-widest uppercase block">CORE TIMELINE MILESTONES TO MONITOR</span>
                  <div className="space-y-1.5">
                    {report.aiAnalysis.whatToWatch?.map((item, idx) => (
                      <div key={idx} className="flex items-center gap-2 font-mono text-xs text-[#2de2a0] bg-[#2de2a0]/5 border border-[#2de2a0]/10 px-3 py-1.5 rounded-md">
                        <span className="text-[10px]">⏱</span>
                        <span className="truncate text-gray-200">{item}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* RIGHT GRAPH ZONE */}
            <div className="lg:col-span-2 space-y-6">
              
              {/* LINEAR CHART LAYER */}
              <div className="bg-[#0c0e14] border border-[#1d2030] rounded-xl p-5 space-y-4">
                <div className="flex items-center justify-between">
                  <span className="text-[9px] font-mono text-[#454866] tracking-widest uppercase">REAL-TIME FORECAST DEVIATION INTERPOLATION PLOT</span>
                  <div className="flex gap-3 font-mono text-[9px] text-[#454866]">
                    <div className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-[#2de2a0]"></span>EXPANSION BAND</div>
                    <div className="flex items-center gap-1"><span className="w-2 h-2 rounded-full bg-[#ff4f70]"></span>BEAR CHANNELS</div>
                  </div>
                </div>

                <div className="bg-[#08090d] rounded-xl border border-[#1d2030] p-2.5 relative overflow-hidden">
                  <svg viewBox="0 0 600 130" className="w-full h-auto overflow-visible">
                    <line x1="0" y1="20" x2="600" y2="20" stroke="#12141c" strokeWidth="1" />
                    <line x1="0" y1="65" x2="600" y2="65" stroke="#1d2030" strokeWidth="1" strokeDasharray="4 4" />
                    <line x1="0" y1="110" x2="600" y2="110" stroke="#12141c" strokeWidth="1" />
                    
                    <path 
                      d={`M 20 70 Q 150 ${65 - (report.aiAnalysis.confidenceScore * 0.45)} 300 ${50 - (report.aiAnalysis.confidenceScore * 0.35)} T 580 ${35 - (report.aiAnalysis.confidenceScore * 0.25)}`} 
                      fill="none" stroke="#2de2a0" strokeWidth="2.5" className="opacity-90"
                    />
                    <path 
                      d={`M 20 70 Q 180 ${70 + (report.aiAnalysis.confidenceScore * 0.25)} 320 ${85 + (report.aiAnalysis.confidenceScore * 0.15)} T 580 120`} 
                      fill="none" stroke="#ff4f70" strokeWidth="1.5" strokeDasharray="3 3" className="opacity-40"
                    />
                    
                    <circle cx="20" cy="70" r="3.5" fill="#00E5FF"/>
                    <circle cx="580" cy={35 - (report.aiAnalysis.confidenceScore * 0.25)} r="3.5" fill="#2de2a0" className="animate-ping"/>
                    <circle cx="580" cy={35 - (report.aiAnalysis.confidenceScore * 0.25)} r="2.5" fill="#2de2a0"/>
                  </svg>
                  <div className="absolute top-2 left-3 font-mono text-[8px] text-[#454866] uppercase">OPTIMISTIC EXPANSION BOUND</div>
                  <div className="absolute bottom-2 left-3 font-mono text-[8px] text-[#454866] uppercase">EXPOSURE FLOOR TRAILS</div>
                </div>
